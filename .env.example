# Copy this file to .env. Only the account and setup username come from you.
SNOWFLAKE_ACCOUNT=yourorg-youraccount
SNOWFLAKE_USER=your_existing_setup_username
# ACCOUNTADMIN is used only to create the demo resources.
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=ELT_WH
SNOWFLAKE_DATABASE=RETAIL_DEMO
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_STAGING_SCHEMA=STAGING
SNOWFLAKE_MARTS_SCHEMA=MARTS
# The start script changes this to the generated service key after setup.
SNOWFLAKE_PRIVATE_KEY_PATH=./secrets/snowflake_key.p8
